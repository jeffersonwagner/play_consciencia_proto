{
  "name": "play-na-consciencia",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "Jogo sério Play na Consciência — conscientização sobre a violência contra a mulher.",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && vitest run",
    "test": "vitest",
    "validate": "vitest run tests/content.test.ts",
    "assets": "node tools/optimize-assets.mjs",
    "build:pesquisa": "npm run check && vite build --mode pesquisa",
    "preview:pesquisa": "vite preview --outDir dist-pesquisa",
    "dev:pesquisa": "vite --mode pesquisa-local",
    "coletor": "node tools/mock-collector.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0"
  }
}
