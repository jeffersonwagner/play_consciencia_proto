# Build de coleta de dados (npm run build:pesquisa) — ver docs/COLETA.md.
# Os valores reais (endereço e token da planilha) ficam em .env.pesquisa.local,
# que não vai para o git. Copie este arquivo para .env.pesquisa.local e preencha.
VITE_RESEARCH=1
# Endereço /exec do Apps Script da planilha
VITE_COLLECT_URL=
# Token da aba Config da planilha
VITE_COLLECT_TOKEN=
